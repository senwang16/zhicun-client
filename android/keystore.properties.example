# Release signing (copy to keystore.properties and fill in; BOTH files are gitignored).
#
# Do NOT commit the real keystore.properties or the .jks file. Keep the keystore outside the
# repository and back it up: losing it means you can never publish an update that installs
# over existing users (they would have to uninstall and lose local data).
storeFile=/absolute/path/to/zhicun-release.jks
storePassword=change-me
keyAlias=zhicun
keyPassword=change-me