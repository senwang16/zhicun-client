<?xml version="1.0" encoding="utf-8"?>
<!--
    备份规则（API 23–30），2026-10-22 审查轮补。

    API 31+ 由 data_extraction_rules.xml 接管，两者都排除全部数据域。
    allowBackup=false 已能挡住 ≤API 30 的云备份；这里显式写出来，一是把"不参与系统备份"
    的意图写进清单（M14 隐私说明依赖这一点），二是满足 lint 对"两套规则应成对出现"的要求。
-->
<full-backup-content>
    <exclude
        domain="root"
        path="." />
    <exclude
        domain="file"
        path="." />
    <exclude
        domain="database"
        path="." />
    <exclude
        domain="sharedpref"
        path="." />
    <exclude
        domain="external"
        path="." />
</full-backup-content>